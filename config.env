# KernelSU-Next
#
# Version matters here. KernelSU-Next's own non-GKI line is the `legacy`
# branch/tags, but those upstream legacy tags carry no SuSFS at all — upstream
# SuSFS (v3.4.x) is a GKI/LKM feature and does not build on 4.14.
#
# So we pin sidex15's `legacy-susfs-v2` line: a fork of KernelSU-Next's
# non-GKI `legacy` branch with SuSFS v2 merged in, which is what KernelSU-Next's
# own maintainers point non-GKI users to when they ask for SuSFS
# (KernelSU-Next issues #1387 and #1429). It is the newest SuSFS-enabled
# non-GKI tag available (2026-09-22) and equals the `legacy-susfs-v2` branch tip.
#
# Note the tag name does NOT mean it is built on upstream v3.4.0-legacy: the
# fork descends from upstream's `legacy` line just after v3.0.1-legacy plus
# 123 SuSFS/backport commits. Verified with `git merge-base` — keep this pin.
export KSU_REPO_URL=https://github.com/sidex15/KernelSU-Next.git
export KSU_REPO_TAG=v3.4.0-legacy-susfs-v2
export KSU_REPO_PIN=d999a2aff11575c6e2f520129ecffb7c6058fb02

# SuSFS — kernel-side patches for 4.14 (fs/, include/linux/, kernel/ hooks)
# The inline-hook script from this pin targets SuSFS 2.3.00+, which is the
# SuSFS generation the susfs-v2 KernelSU-Next driver above speaks.
export SUSFS_REPO_URL=https://github.com/JackA1ltman/NonGKI_Kernel_Build_2nd.git
export SUSFS_REPO_PIN=dcd789634247c77d8549a42aef232c680a905585

# Build identity
export KBUILD_BUILD_USER=Chronix
export KBUILD_BUILD_HOST=Snowy
